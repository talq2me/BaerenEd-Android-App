<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/story_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="Story page"
            android:scaleType="fitCenter" />

        <ScrollView
            android:id="@+id/story_english_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E6FFFFFF"
            android:fillViewport="true"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/story_english_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.25"
                android:textColor="#222222"
                android:textSize="22sp" />
        </ScrollView>
    </FrameLayout>

    <TextView
        android:id="@+id/story_page_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="8dp"
        android:textColor="#555555"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/story_btn_prev"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/button_rounded_secondary"
            android:text="&lt;"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/story_btn_english"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/button_rounded_success"
            android:text="English"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/story_btn_next"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/button_rounded_primary"
            android:text="&gt;"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
